{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["chrome"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "../../packages/browser/src/dom-snapshot.ts",
    "../../packages/browser/src/extension-bridge.ts",
    "../../packages/browser/src/driver.ts",
    "../../packages/protocol/src/browser.ts"
  ]
}
