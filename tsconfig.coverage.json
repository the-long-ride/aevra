{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".coverage-dist",
    "sourceMap": true,
    "inlineSources": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "exclude": [
    "dist",
    "node_modules",
    ".test-dist",
    ".coverage-dist",
    "coverage",
    "apps/web-react"
  ]
}
