# Required Admin credentials
AEVRA_USERNAME=admin
AEVRA_PASSWORD=change-me

# Optional OAuth connection continuity tuning.
# Access tokens are short-lived; refresh-family expiry is absolute and is not extended by rotation.
AEVRA_OAUTH_ACCESS_TOKEN_TTL_MS=3600000
AEVRA_OAUTH_REFRESH_TOKEN_TTL_MS=2592000000
AEVRA_CONNECTION_RECONNECT_GRACE_MS=900000
