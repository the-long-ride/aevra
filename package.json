{
  "name": "@the-long-ride/aevra",
  "version": "1.0.5",
  "type": "module",
  "workspaces": [
    "apps/web-react"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noCheck && npm --prefix apps/web-react run build && node scripts/copy-manual.mjs",
    "build:extension": "node scripts/pack-extension.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:source && npm run lint:loc && npm run lint:dead",
    "lint:dead": "knip",
    "lint:loc": "node scripts/loc-lint.mjs",
    "lint:source": "node scripts/lint.mjs",
    "prepack": "npm run build",
    "start": "node dist/apps/cli/src/cli.js start",
    "test": "npm run test:node && npm run test:scripts && npm --prefix apps/web-react test",
    "test:contract": "node scripts/test.mjs contract",
    "test:coverage": "npm run test:coverage:node && npm run test:coverage:web",
    "test:coverage:node": "node scripts/test-coverage-node.mjs",
    "test:coverage:web": "npm --prefix apps/web-react run test:coverage",
    "test:extension": "vitest run --coverage --root apps/extension",
    "test:gate": "npm run format:check && npm run lint && npm run typecheck && npm run test:scripts && npm run test:extension && npm run test:coverage && npm run build && npm run build:extension && npm run test:ui-parity:only",
    "test:integration": "node scripts/test.mjs integration",
    "test:node": "node scripts/test.mjs product",
    "test:portability": "npm run test:node && npm run test:scripts && npm --prefix apps/web-react test && npm run build",
    "test:scripts": "node scripts/test.mjs scripts",
    "test:security": "node scripts/test.mjs security",
    "test:ui-parity": "npm run build && npm run test:ui-parity:only",
    "test:ui-parity:only": "playwright test",
    "test:unit": "node scripts/test.mjs unit",
    "test:web": "npm run test:web:contracts && npm --prefix apps/web-react test",
    "test:web:contracts": "node --test scripts/test/react-ui-source.test.mjs scripts/test/react-design-contract.test.mjs scripts/test/react-only-ui.test.mjs scripts/test/web-build-script.test.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json && npm --prefix apps/web-react run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "c8": "^10.1.3",
    "jsdom": "^26.0.0",
    "knip": "^5.48.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.0",
    "vitest": "^5.0.1"
  },
  "description": "Workspace-scoped local MCP execution gateway for AI web interfaces with policy, recovery, and audit controls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-long-ride/aevra.git"
  },
  "bugs": {
    "url": "https://github.com/the-long-ride/aevra/issues"
  },
  "homepage": "https://github.com/the-long-ride/aevra#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-gateway",
    "ai-agent",
    "chatgpt",
    "claude",
    "grok",
    "automation",
    "gateway",
    "security",
    "zero-trust",
    "audit",
    "local",
    "workspace",
    "cli",
    "cross-platform",
    "oauth",
    "hooks"
  ],
  "bin": {
    "aevra": "dist/apps/cli/src/cli.js"
  },
  "files": [
    "dist/apps/cli/src",
    "dist/apps/core/src",
    "dist/apps/worker/src",
    "dist/apps/web",
    "dist/packages/admin-contracts/src",
    "dist/packages/executor/src",
    "dist/packages/ipc/src",
    "dist/packages/mcp-tools/src",
    "dist/packages/notifications/src",
    "dist/packages/protocol/src",
    "dist/packages/secrets/src",
    "dist/packages/security/src",
    "dist/packages/store/src",
    "docs/user-manual",
    "installers",
    "README.md",
    "GUIDELINE.md",
    "CHANGELOG.md"
  ]
}
