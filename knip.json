{
  "exclude": ["types"],
  "workspaces": {
    ".": {
      "entry": [
        "apps/cli/src/cli.ts",
        "apps/core/src/main.ts",
        "apps/worker/src/main.ts",
        "packages/mcp-tools/src/register.ts",
        "tests/ui-parity/*.spec.ts",
        "tests/ui-parity/static-server.mjs",
        "scripts/run-ts-tests.mjs",
        "scripts/ts-loader.mjs",
        "scripts/test/*.test.mjs",
        "apps/*/test/**/*.test.ts",
        "packages/*/test/**/*.test.ts",
        "tests/**/*.test.{ts,mjs}"
      ],
      "project": [
        "apps/cli/**/*.{ts,js,mjs}",
        "apps/core/**/*.{ts,js,mjs}",
        "apps/worker/**/*.{ts,js,mjs}",
        "packages/**/*.{ts,tsx,js,mjs}",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,mjs}"
      ],
      "paths": {
        "@aevra/admin-contracts": ["packages/admin-contracts/src/index.ts"]
      },
      "ignoreDependencies": ["@types/chrome", "c8"]
    },
    "apps/web-react": {
      "paths": {
        "@aevra/admin-contracts": ["../../packages/admin-contracts/src/index.ts"]
      }
    }
  }
}
